{
  "name": "actionos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:security": "tsx --test tests/unit/*security*.test.ts tests/integration/supabase-security-and-webhooks.test.ts tests/integration/ledger-persistence-and-privacy.test.ts tests/integration/schema-migration.test.ts",
    "db:check": "node scripts/check-live.mjs",
    "db:verify": "node scripts/verify-supabase-staging.mjs",
    "db:verify:offline": "node scripts/verify-supabase-staging.mjs --mode=offline",
    "db:verify:staging": "node scripts/verify-supabase-staging.mjs --mode=staging-required",
    "deps:verify": "node scripts/verify-dependency-integrity.mjs",
    "demo:renew": "tsx scripts/demo-renewal-flow.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
