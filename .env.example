# ==============================================================================
# ACTIONOS ENVIRONMENT CONFIGURATION
# NITDA National AI Innovation Challenge 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & REALTIME (Postgres CDC, Auth, & Storage)
# ------------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard/project/<your-project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Service role key is required for administrative migrations, seeds, & backend webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-to-browser

# ------------------------------------------------------------------------------
# 2. FRSC (Federal Road Safety Corps) NVIS REALTIME GATEWAY
# ------------------------------------------------------------------------------
# Base endpoint for National Vehicle Identification System (NVIS) / State MVAA
FRSC_API_BASE_URL=https://nvis.frsc.gov.ng/api/v1
FRSC_API_KEY=your-frsc-partner-api-key
FRSC_CLIENT_ID=your-frsc-partner-client-id
FRSC_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 3. N-ATLAS SOVEREIGN NIGERIAN MULTILINGUAL AI MODEL (NITDA / NCAIR)
# ------------------------------------------------------------------------------
# Endpoints provided by NITDA / NCAIR / AI Collective (or custom vLLM / HuggingFace proxy)
N_ATLAS_API_URL=https://api.n-atlas.ng/v1
N_ATLAS_API_KEY=your-n-atlas-api-key
N_ATLAS_MODEL=n-atlas-multilingual

# ------------------------------------------------------------------------------
# 4. PAYSTACK PAYMENT GATEWAY (Instant Checkout & Realtime Webhooks)
# ------------------------------------------------------------------------------
# Set to 'paystack' to use live or test Paystack, or 'mock_paystack' for offline benchmark
PAYMENT_PROVIDER=paystack
# Secret key: sk_test_... (Test mode) or sk_live_... (Live production)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Public key: pk_test_... (Test mode) or pk_live_... (Live production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Paystack Webhook Destination: https://<your-app-domain>/api/webhooks/payment

# ------------------------------------------------------------------------------
# 5. APPLICATION RUNTIME & TENANCY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Options: 'demo' (allows sandbox fallback) | 'production' (strictly fails closed)
ACTIONOS_RUNTIME_MODE=demo

# ------------------------------------------------------------------------------
# 6. CRYPTOGRAPHIC SIGNING KEYS (Required when ACTIONOS_RUNTIME_MODE=production)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
ACTIONOS_QUOTE_SIGNING_KEY=your-dedicated-quote-hmac-signing-key
ACTION_LEDGER_SIGNING_KEY=your-ed25519-ledger-signing-private-key
ACTIONOS_WEBHOOK_SIGNING_SECRET=your-webhook-hmac-secret-key
